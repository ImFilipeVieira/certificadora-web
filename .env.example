# Configuracao local segura para portfolio
# Copie para .env apenas no ambiente local. Nunca publique .env com valores reais.

APP_VERSION=1.4.1-portfolio
SECRET_KEY=YOUR_RANDOM_SECRET_KEY_HERE

# Modo demo local com dados ficticios.
# Use apenas para portfolio/desenvolvimento.
DEMO_MODE=true
AUTH_PROVIDER=mock
MOCK_AUTH_PASSWORD=change-this-demo-password
MFA_REQUIRED=false

# Banco local demo. Para producao, use variaveis APP_DB_* / AUDIT_DB_* ou URLs seguras.
APP_DATABASE_URL=sqlite:///portfolio_demo.db
AUDIT_DATABASE_URL=sqlite:///portfolio_demo.db

# LDAP/AD opcional para ambiente real. Mantenha vazio no modo demo.
LDAP_HOST=
LDAP_PORT=636
LDAP_USE_SSL=true
LDAP_BASE_DN=
LDAP_SEARCH_ATTRIBUTE=sAMAccountName
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=YOUR_LDAP_BIND_PASSWORD_HERE

MFA_ISSUER=Certificadora Web

APP_DB_HOST=127.0.0.1
APP_DB_PORT=3306
APP_DB_USER=certificadora_app
APP_DB_PASSWORD=YOUR_APP_DB_PASSWORD_HERE
APP_DB_NAME=certificadora_db

AUDIT_DB_HOST=127.0.0.1
AUDIT_DB_PORT=3306
AUDIT_DB_USER=certificadora_audit
AUDIT_DB_PASSWORD=YOUR_AUDIT_DB_PASSWORD_HERE
AUDIT_DB_NAME=audit_log

DB_SCHEMA_AUTO_MIGRATE=false

STORAGE_ROOT=storage
CERT_STORAGE_DIR=storage/certificates
CA_CERT_PATH=ca/example-ca.crt
CA_KEY_PATH=ca/example-ca.key
CA_SERIAL_PATH=ca/example-ca.srl
MAX_CERT_VALIDITY_DAYS=825
ALLOW_UNPROTECTED_PKCS12_EXPORT=false

APP_HOST=127.0.0.1
APP_PORT=5000
FLASK_DEBUG=false

WEB_SSL_ENABLED=false
WEB_SSL_CERT_PATH=
WEB_SSL_KEY_PATH=
WEB_SSL_KEY_PASSWORD=
